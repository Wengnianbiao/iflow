{
  "name": "iflow-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "test:mapping": "node --experimental-strip-types --test tests/mappingConfig.test.mjs",
    "test:executions": "node --experimental-strip-types --test tests/workflowSearch.test.mjs tests/taskExecutionIndex.test.mjs",
    "test:statistics": "node --experimental-strip-types --test tests/executionStatistics.test.mjs",
    "test:definition": "node --test tests/workflowDefinition.test.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@monaco-editor/react": "^4.7.0",
    "@mui/icons-material": "^7.3.1",
    "@mui/material": "^7.3.1",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.101.4",
    "@vitejs/plugin-react": "^4.6.0",
    "@xstate/react": "3.2.2",
    "acorn": "^8.19.0",
    "axios": "^1.7.9",
    "monaco-editor": "^0.55.1",
    "prettier": "^3.9.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet": "^6.1.0",
    "react-router-dom": "^6.30.1",
    "reaflow": "5.1.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "xstate": "4.38.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-helmet": "^6.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
