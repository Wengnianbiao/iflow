<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.helianhealth.agent.repository.mapper.agent.InterfaceWorkflowMapper">

    <resultMap id="BaseResultMap" type="com.helianhealth.agent.repository.model.po.InterfaceWorkflowPO">
        <id column="flow_id" property="flowId" />
        <result column="flow_name" property="flowName" />
        <result column="interface_uri" property="interfaceUri" />
        <result column="route_extension" property="routeExtension" />
        <result column="content_type" property="contentType" />
        <result column="content_meta_info" property="contentMetaInfo" />
        <!-- 为 firstFlowNodes 绑定类型处理器 -->
        <result column="first_flow_nodes"
                property="firstFlowNodes"
                typeHandler="com.helianhealth.agent.common.typehandler.ListIntegerTypeHandler"
                jdbcType="VARCHAR" />

        <result column="status" property="status" />
    </resultMap>

    <insert id="createWorkflow"
            parameterType="com.helianhealth.agent.repository.model.po.InterfaceWorkflowPO"
            useGeneratedKeys="true"
            keyProperty="flowId"
            keyColumn="flow_id">
        INSERT INTO interface_workflow (
            flow_name,
            interface_uri,
            route_extension,
            content_type,
            content_meta_info,
            first_flow_nodes,
            status
        ) VALUES (
                     #{flowName},
                     #{interfaceUri},
                     #{routeExtension},
                     #{contentType},
                     #{contentMetaInfo},
                     #{firstFlowNodes, typeHandler=com.helianhealth.agent.common.typehandler.ListIntegerTypeHandler},
                     #{status}
                 )
    </insert>

    <select id="selectByInterfaceUri" resultMap="BaseResultMap">
        select *
        from interface_workflow
        where interface_uri = #{interfaceUri}
        and status = 1
    </select>

    <select id="selectByFlowId" resultMap="BaseResultMap">
        select *
        from interface_workflow
        where flow_id = #{flowId}
    </select>

    <select id="selectAllWorkflows" resultMap="BaseResultMap">
        select *
        from interface_workflow
        where status = 1
    </select>

    <update id="updateWorkflow" parameterType="com.helianhealth.agent.repository.model.po.InterfaceWorkflowPO">
        UPDATE interface_workflow
        <set>
            <if test="flowName != null">flow_name = #{flowName},</if>
            <if test="interfaceUri != null">interface_uri = #{interfaceUri},</if>
            <if test="routeExtension != null">route_extension = #{routeExtension},</if>
            <if test="contentType != null">content_type = #{contentType},</if>
            <if test="contentMetaInfo != null">content_meta_info = #{contentMetaInfo},</if>
            <if test="firstFlowNodes != null">first_flow_nodes = #{firstFlowNodes, typeHandler=com.helianhealth.agent.common.typehandler.ListIntegerTypeHandler},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        WHERE flow_id = #{flowId}
    </update>

    <update id="updateRouteExtension">
        UPDATE interface_workflow
        SET route_extension = #{routeExtension}
        WHERE flow_id = #{flowId}
    </update>

    <delete id="deleteByFlowId">
        DELETE FROM interface_workflow WHERE flow_id = #{flowId}
    </delete>
</mapper>
