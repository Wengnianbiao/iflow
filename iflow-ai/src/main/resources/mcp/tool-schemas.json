{
  "$comment": "iFlow MCP Server — 核心 Tool 注册表。业务域 Tool 将在 Conductor 新范式接入后追加。",
  "$defs": {
    "HealthCheckMcpView": {
      "type": "object",
      "properties": {
        "status": { "type": "string", "enum": ["UP", "DOWN"] },
        "serverName": { "type": "string" },
        "serverVersion": { "type": "string" },
        "database": { "type": "string", "enum": ["UP", "DOWN", "SKIPPED"] },
        "message": { "type": "string" }
      },
      "required": ["status", "serverName", "serverVersion", "database", "message"]
    }
  },
  "tools": [
    {
      "name": "agent_health",
      "description": "iFlow MCP 健康检查。ping 仅探测 MCP 进程；check 可选探测 DataSource。",
      "inputSchema": {
        "type": "object",
        "required": ["action"],
        "additionalProperties": false,
        "properties": {
          "action": { "type": "string", "enum": ["ping", "check"] }
        }
      },
      "outputSchema": {
        "description": "McpToolPayload.data = HealthCheckMcpView",
        "$ref": "#/$defs/HealthCheckMcpView"
      }
    }
  ]
}
