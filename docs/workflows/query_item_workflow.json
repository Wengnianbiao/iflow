{
  "name": "hl-open-api/query-item",
  "version": 1,
  "displayName": "查询费用服务项目列表",
  "description": "POST /hl-open-api/query-item。请求体为费用服务项目查询入参（对象或数组，也可包在 request 里），同步调用 bd.serviceitem.serviceItemProvider.queryFeeServiceItemList，不加验签、不加解密。返回的是服务参考价格。",
  "timeoutPolicy": "TIME_OUT_WF",
  "inputParameters": [
    "body"
  ],
  "outputParameters": {},
  "tasks": [
    {
      "name": "组装费用服务项目查询入参",
      "taskReferenceName": "wrap_request_ref",
      "type": "INLINE",
      "optional": false,
      "inputParameters": {
        "body": "${workflow.input.body}",
        "evaluatorType": "graaljs",
        "expression": "(function () { var body = $.body; if (body == null) { body = {}; } var query = (body && typeof body === 'object' && !Array.isArray(body) && body.request != null) ? body.request : body; return Array.isArray(query) ? query : [query]; })()"
      }
    },
    {
      "name": "查询费用服务项目列表",
      "taskReferenceName": "call_his_ref",
      "type": "HTTP",
      "optional": false,
      "inputParameters": {
        "uri": "http://132.147.181.104/gateway/api",
        "method": "POST",
        "contentType": "application/json",
        "accept": "application/json",
        "connectionTimeOut": 5000,
        "readTimeOut": 30000,
        "headers": {
          "X-Service-Id": "bd.serviceitem.serviceItemProvider",
          "X-Service-Method": "queryFeeServiceItemList"
        },
        "body": "${wrap_request_ref.output}"
      }
    },
    {
      "name": "返回查询结果",
      "taskReferenceName": "unwrap_response_ref",
      "type": "INLINE",
      "optional": false,
      "inputParameters": {
        "body": "${call_his_ref.output.body}",
        "evaluatorType": "graaljs",
        "expression": "(function () { return $.body; })()"
      }
    }
  ]
}
