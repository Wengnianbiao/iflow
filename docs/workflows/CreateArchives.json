{
  "name": "CreateArchives",
  "displayName": "杭州903患者建档",
  "version": 1,
  "description": "将 Jarvis CreateArchives 入参映射为 GHIS setPatientInfo，经测试网关 /gateway/api 调用建档，回写出参 code / message / rsp.outPatientCode / rsp.visitNo。",
  "correlationExpression": "${workflow.input.data.patientCode}",
  "inputParameters": [
    "data",
    "BusinessMethod",
    "BusinessCode",
    "DepartType"
  ],
  "outputParameters": {
    "code": "${map_output_ref.output.code}",
    "message": "${map_output_ref.output.message}",
    "rsp": "${map_output_ref.output.rsp}"
  },
  "tasks": [
    {
      "name": "映射HIS建档业务数据",
      "taskReferenceName": "map_his_patient_ref",
      "type": "MAPPING",
      "optional": false,
      "inputParameters": {
        "payload": "${workflow.input.data}",
        "paramsConfig": [
          {
            "targetParamKey": "patient",
            "targetParamType": "OBJECT",
            "sourceParamType": "NONE",
            "paramDesc": "GHIS setPatientInfo 业务对象",
            "childParams": [
              {
                "targetParamKey": "visitBdmd",
                "targetParamType": "STRING",
                "sourceParamType": "NONE",
                "mappingType": "CONSTANT",
                "mappingRule": "66fca570063ef80001a5da41",
                "paramDesc": "基础数据账户 accountId"
              },
              {
                "targetParamKey": "visitOrganization",
                "targetParamType": "STRING",
                "sourceParamType": "NONE",
                "mappingType": "CONSTANT",
                "mappingRule": "66fca42db0c0ad0001f1a9f4",
                "paramDesc": "医疗机构组织机构代码"
              },
              {
                "targetParamKey": "visitTenant",
                "targetParamType": "STRING",
                "sourceParamType": "NONE",
                "mappingType": "CONSTANT",
                "mappingRule": "GHIS",
                "paramDesc": "租户"
              },
              {
                "targetParamKey": "visitDept",
                "targetParamType": "STRING",
                "sourceParamType": "NONE",
                "mappingType": "CONSTANT",
                "mappingRule": "66fca4551d3a1d0001fab02d",
                "paramDesc": "科室 departmentId"
              },
              {
                "targetParamKey": "visitUser",
                "targetParamType": "STRING",
                "sourceParamType": "NONE",
                "mappingType": "CONSTANT",
                "mappingRule": "6a4db0dc4da7fc0001a9609a",
                "paramDesc": "用户 userId"
              },
              {
                "sourceParamKey": "patientName",
                "sourceParamType": "STRING",
                "targetParamKey": "name",
                "targetParamType": "STRING",
                "mappingType": "NAME",
                "paramDesc": "患者姓名"
              },
              {
                "sourceParamKey": "birthday",
                "sourceParamType": "STRING",
                "targetParamKey": "birthDate",
                "targetParamType": "STRING",
                "mappingType": "NAME",
                "paramDesc": "出生日期"
              },
              {
                "sourceParamKey": "sex",
                "sourceParamType": "STRING",
                "targetParamKey": "sex",
                "targetParamType": "INTEGER",
                "mappingType": "NAME",
                "paramDesc": "性别代码"
              },
              {
                "sourceParamKey": "identitycard",
                "sourceParamType": "STRING",
                "targetParamKey": "idCard",
                "targetParamType": "STRING",
                "mappingType": "NAME",
                "paramDesc": "身份证件号码"
              },
              {
                "sourceParamKey": "cardType",
                "sourceParamType": "STRING",
                "targetParamKey": "idCardCode",
                "targetParamType": "STRING",
                "mappingType": "EXPRESSION",
                "mappingRule": "#data[cardType] == '1' || #data[cardType] == 1 ? '01' : #data[cardType]",
                "paramDesc": "身份证件类型，1→01"
              },
              {
                "sourceParamKey": "phone",
                "sourceParamType": "STRING",
                "targetParamKey": "patientPhone",
                "targetParamType": "STRING",
                "mappingType": "NAME",
                "paramDesc": "患者电话号码"
              },
              {
                "sourceParamKey": "marriage",
                "sourceParamType": "STRING",
                "targetParamKey": "maritalStatus",
                "targetParamType": "STRING",
                "mappingType": "EXPRESSION",
                "mappingRule": "#data[marriage] == '1' || #data[marriage] == 1 ? '10' : (#data[marriage] == '2' || #data[marriage] == 2 ? '20' : (#data[marriage] == '3' || #data[marriage] == 3 ? '40' : (#data[marriage] == '4' || #data[marriage] == 4 ? '30' : '90')))",
                "paramDesc": "婚姻：1未婚→10，2已婚→20，3离婚→40，4丧偶→30"
              },
              {
                "sourceParamKey": "nation",
                "sourceParamType": "STRING",
                "targetParamKey": "ethnicGroup",
                "targetParamType": "STRING",
                "mappingType": "NAME",
                "paramDesc": "民族代码"
              },
              {
                "sourceParamKey": "orgName",
                "sourceParamType": "STRING",
                "targetParamKey": "workUnit",
                "targetParamType": "STRING",
                "mappingType": "NAME",
                "paramDesc": "工作单位名称"
              },
              {
                "sourceParamKey": "hisPatientId",
                "sourceParamType": "STRING",
                "targetParamKey": "mpi",
                "targetParamType": "STRING",
                "mappingType": "NAME",
                "paramDesc": "业务系统患者档案ID"
              },
              {
                "sourceParamKey": "visitNo",
                "sourceParamType": "STRING",
                "targetParamKey": "medicalCardId",
                "targetParamType": "STRING",
                "mappingType": "NAME",
                "paramDesc": "就诊卡号"
              },
              {
                "sourceParamKey": "doctorInfo.userName",
                "sourceParamType": "STRING",
                "targetParamKey": "author",
                "targetParamType": "STRING",
                "mappingType": "NAME",
                "paramDesc": "建卡者姓名"
              },
              {
                "sourceParamKey": "doctorInfo.number",
                "sourceParamType": "STRING",
                "targetParamKey": "authorId",
                "targetParamType": "STRING",
                "mappingType": "NAME",
                "paramDesc": "建卡者代码"
              },
              {
                "targetParamKey": "addressDTO",
                "targetParamType": "OBJECT",
                "sourceParamType": "NONE",
                "paramDesc": "地址",
                "childParams": [
                  {
                    "sourceParamKey": "address",
                    "sourceParamType": "STRING",
                    "targetParamKey": "addressDetail",
                    "targetParamType": "STRING",
                    "mappingType": "NAME",
                    "paramDesc": "地址全称"
                  }
                ]
              }
            ]
          },
          {
            "targetParamKey": "timestamp",
            "targetParamType": "STRING",
            "sourceParamType": "NONE",
            "mappingType": "EXPRESSION",
            "mappingRule": "T(String).valueOf(T(System).currentTimeMillis())",
            "paramDesc": "当前时间戳"
          },
          {
            "targetParamKey": "encryptData",
            "targetParamType": "STRING",
            "sourceParamType": "NONE",
            "mappingType": "EXPRESSION",
            "mappingRule": "T(com.helianhealth.agent.common.utils.JsonUtils).toJsonString(T(java.util.Collections).singletonList(#data[patient]))",
            "paramDesc": "业务数据 JSON 数组字符串，读取同级已映射的 patient"
          }
        ]
      }
    },
    {
      "name": "调用HIS建档",
      "taskReferenceName": "call_his_ref",
      "type": "HTTP",
      "optional": false,
      "inputParameters": {
        "uri": "http://132.147.181.1044/gateway/api",
        "method": "POST",
        "contentType": "application/json",
        "accept": "application/json",
        "connectionTimeOut": 5000,
        "readTimeOut": 30000,
        "body": {
          "appId": "6a4daeb8b4ac040015386004",
          "encryptData": "${map_his_patient_ref.output.encryptData}",
          "sign": "",
          "timestamp": "${map_his_patient_ref.output.timestamp}",
          "version": "1.0.0",
          "beanName": "exchange.stand.setPatientInfoProvider",
          "methodName": "setPatientInfo"
        }
      }
    },
    {
      "name": "映射建档出参",
      "taskReferenceName": "map_output_ref",
      "type": "MAPPING",
      "optional": false,
      "inputParameters": {
        "payload": "${call_his_ref.output.body}",
        "paramsConfig": [
          {
            "targetParamKey": "code",
            "targetParamType": "STRING",
            "sourceParamType": "NONE",
            "mappingType": "EXPRESSION",
            "mappingRule": "(#data[code] == 200 || #data[code] == '200' || #data[code] == 0 || #data[code] == '0') && (#data[body] == null || #data[body][status] == null || #data[body][status] == true) ? '200' : '-1'",
            "paramDesc": "200成功 / -1失败"
          },
          {
            "targetParamKey": "message",
            "targetParamType": "STRING",
            "sourceParamType": "NONE",
            "mappingType": "EXPRESSION",
            "mappingRule": "(#data[code] == 200 || #data[code] == '200' || #data[code] == 0 || #data[code] == '0') && (#data[body] == null || #data[body][status] == null || #data[body][status] == true) ? '成功' : (#data[body] != null && #data[body][detail] != null ? #data[body][detail] : (#data[message] != null ? #data[message] : '失败'))",
            "paramDesc": "响应描述"
          },
          {
            "targetParamKey": "rsp",
            "targetParamType": "OBJECT",
            "sourceParamType": "NONE",
            "paramDesc": "建档回写",
            "childParams": [
              {
                "targetParamKey": "outPatientCode",
                "targetParamType": "STRING",
                "sourceParamType": "STRING",
                "mappingType": "EXPRESSION",
                "mappingRule": "#data[body] != null && #data[body][data] != null ? (#data[body][data][mpi] ?: #data[body][data][idPi]) : (#data[data] != null ? (#data[data][mpi] ?: #data[data][idPi]) : null)",
                "paramDesc": "PATIENT_ID"
              },
              {
                "targetParamKey": "visitNo",
                "targetParamType": "STRING",
                "sourceParamType": "STRING",
                "mappingType": "EXPRESSION",
                "mappingRule": "#data[body] != null && #data[body][data] != null ? #data[body][data][medicalCardId] : (#data[data] != null ? #data[data][medicalCardId] : null)",
                "paramDesc": "就诊卡号 VISIT_NO"
              }
            ]
          }
        ]
      }
    }
  ]
}
