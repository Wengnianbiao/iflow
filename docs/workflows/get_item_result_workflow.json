{
  "name": "GetItemResult",
  "version": 1,
  "displayName": "报告查询",
  "description": "按 ServiceProviderType 路由报告查询；LIS 按条码号调用对方结果查询接口后映射为 Jarvis 出参",
  "correlationExpression": "${workflow.input.PatientCode}",
  "inputParameters": [
    "BusinessMethod",
    "ServiceProviderType",
    "PatientCode",
    "BarCodeList",
    "OutFeeItemIdList",
    "ApplyNoList",
    "ParamType"
  ],
  "outputParameters": {},
  "tasks": [
    {
      "name": "报告查询_分支路由",
      "taskReferenceName": "switch_report_ref",
      "type": "SWITCH",
      "evaluatorType": "value-param",
      "expression": "serviceProviderType",
      "optional": false,
      "inputParameters": {
        "serviceProviderType": "${workflow.input.ServiceProviderType}"
      },
      "decisionCases": {
        "LIS": [
          {
            "name": "映射LIS报告查询入参",
            "taskReferenceName": "mapping_lis_report_req_ref",
            "type": "MAPPING",
            "optional": false,
            "inputParameters": {
              "payload": "${workflow.input}",
              "paramsConfig": [
                {
                  "targetParamKey": "patientCode",
                  "targetParamType": "STRING",
                  "mappingType": "EXPRESSION",
                  "mappingRule": "$.PatientCode || $.patientCode || ''",
                  "paramDesc": "体检编号"
                },
                {
                  "targetParamKey": "barCodes",
                  "targetParamType": "ARRAY",
                  "mappingType": "EXPRESSION",
                  "mappingRule": "$.BarCodeList || $.barCodeList || $.barCodes || []",
                  "paramDesc": "条码号列表"
                }
              ]
            }
          },
          {
            "name": "LIS报告查询",
            "taskReferenceName": "lis_report_ref",
            "type": "HTTP",
            "optional": false,
            "inputParameters": {
              "uri": "http://127.0.0.1:8080/query-lis-result",
              "method": "POST",
              "contentType": "application/json",
              "accept": "application/json",
              "connectionTimeOut": 5000,
              "readTimeOut": 60000,
              "body": "${mapping_lis_report_req_ref.output}"
            }
          },
          {
            "name": "映射LIS报告查询出参",
            "taskReferenceName": "mapping_lis_report_ref",
            "type": "MAPPING",
            "optional": false,
            "inputParameters": {
              "payload": "${lis_report_ref.output.body}",
              "paramsConfig": [
                {
                  "targetParamKey": "code",
                  "targetParamType": "STRING",
                  "mappingType": "EXPRESSION",
                  "mappingRule": "(function () { var c = $.code; if (c == null) return '200'; return (String(c) === '200' || c === 200) ? '200' : '-1'; })()",
                  "paramDesc": "200成功 / -1失败"
                },
                {
                  "targetParamKey": "message",
                  "targetParamType": "STRING",
                  "mappingType": "EXPRESSION",
                  "mappingRule": "$.message || $.msg || (($.code == null || String($.code) === '200' || $.code === 200) ? '成功' : '失败')"
                },
                {
                  "targetParamKey": "rsp",
                  "targetParamType": "ARRAY",
                  "mappingType": "ARRAY_MAP",
                  "sourceParamKey": "$.data",
                  "itemAlias": "item",
                  "itemTemplate": {
                    "targetParamType": "OBJECT",
                    "mappingType": "OBJECT",
                    "childParams": [
                      {
                        "targetParamKey": "serviceProviderType",
                        "targetParamType": "STRING",
                        "mappingType": "CONSTANT",
                        "mappingRule": "LIS",
                        "paramDesc": "厂商类型"
                      },
                      {
                        "targetParamKey": "patientCode",
                        "targetParamType": "STRING",
                        "mappingType": "NAME",
                        "sourceParamKey": "item.patientCode",
                        "paramDesc": "体检编号"
                      },
                      {
                        "targetParamKey": "applyNo",
                        "targetParamType": "STRING",
                        "mappingType": "NAME",
                        "sourceParamKey": "item.applyId",
                        "paramDesc": "申请单号"
                      },
                      {
                        "targetParamKey": "barCode",
                        "targetParamType": "STRING",
                        "mappingType": "NAME",
                        "sourceParamKey": "item.barCode",
                        "paramDesc": "条码号"
                      },
                      {
                        "targetParamKey": "outFeeItemId",
                        "targetParamType": "STRING",
                        "mappingType": "NAME",
                        "sourceParamKey": "item.itemId",
                        "paramDesc": "收费项外部编码，对应申请单 itemId"
                      },
                      {
                        "targetParamKey": "outFeeItemName",
                        "targetParamType": "STRING",
                        "mappingType": "NAME",
                        "sourceParamKey": "item.itemName",
                        "paramDesc": "检验大项名称"
                      },
                      {
                        "targetParamKey": "outExamItemId",
                        "targetParamType": "STRING",
                        "mappingType": "NAME",
                        "sourceParamKey": "item.examItemId",
                        "paramDesc": "检查项外部编码"
                      },
                      {
                        "targetParamKey": "outExamItemName",
                        "targetParamType": "STRING",
                        "mappingType": "NAME",
                        "sourceParamKey": "item.examItemName",
                        "paramDesc": "检查项名称"
                      },
                      {
                        "targetParamKey": "examItemValue",
                        "targetParamType": "STRING",
                        "mappingType": "NAME",
                        "sourceParamKey": "item.examValue",
                        "paramDesc": "检验结果"
                      },
                      {
                        "targetParamKey": "listag",
                        "targetParamType": "STRING",
                        "mappingType": "EXPRESSION",
                        "mappingRule": "item.listag == null ? '' : String(item.listag)",
                        "paramDesc": "LIS标记符，正常/阴性为空"
                      },
                      {
                        "targetParamKey": "idSeverelevel",
                        "targetParamType": "INTEGER",
                        "mappingType": "EXPRESSION",
                        "mappingRule": "(function () { var t = String(item.listag == null ? '' : item.listag).trim(); if (t === '' || t === '-' || t === '阴性' || t === '正常') return 0; return 3; })()",
                        "paramDesc": "有异常标记则 3，否则 0"
                      },
                      {
                        "targetParamKey": "rangeValue",
                        "targetParamType": "STRING",
                        "mappingType": "NAME",
                        "sourceParamKey": "item.rangeValue",
                        "paramDesc": "参考范围"
                      },
                      {
                        "targetParamKey": "units",
                        "targetParamType": "STRING",
                        "mappingType": "EXPRESSION",
                        "mappingRule": "item.units == null ? '' : String(item.units)",
                        "paramDesc": "单位"
                      },
                      {
                        "targetParamKey": "examDoctor",
                        "targetParamType": "STRING",
                        "mappingType": "NAME",
                        "sourceParamKey": "item.examDoctor",
                        "paramDesc": "检验医生"
                      },
                      {
                        "targetParamKey": "examTime",
                        "targetParamType": "STRING",
                        "mappingType": "NAME",
                        "sourceParamKey": "item.examDate",
                        "paramDesc": "检验时间"
                      },
                      {
                        "targetParamKey": "auditDoctor",
                        "targetParamType": "STRING",
                        "mappingType": "NAME",
                        "sourceParamKey": "item.auditDoctor",
                        "paramDesc": "审核医生"
                      },
                      {
                        "targetParamKey": "auditTime",
                        "targetParamType": "STRING",
                        "mappingType": "NAME",
                        "sourceParamKey": "item.auditDate",
                        "paramDesc": "审核时间"
                      }
                    ]
                  },
                  "paramDesc": "一行一个检验小项"
                }
              ]
            }
          }
        ],
        "ECG": [
          {
            "name": "心电报告查询",
            "taskReferenceName": "ecg_report_ref",
            "type": "HTTP",
            "optional": false,
            "inputParameters": {
              "uri": "http://127.0.0.1:8080",
              "method": "GET",
              "contentType": "application/json",
              "accept": "application/json",
              "connectionTimeOut": 5000,
              "readTimeOut": 30000
            }
          }
        ],
        "PACS": []
      },
      "defaultCase": []
    }
  ]
}
