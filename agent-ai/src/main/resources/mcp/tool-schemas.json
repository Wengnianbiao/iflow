                "description": "仅 filter / remote"
              }
            },
            "required": ["action", "type", "extensionName", "className"],
            "additionalProperties": false
          },
          {
            "properties": {
              "action": { "const": "update" },
              "type": { "type": "string", "enum": ["filter", "remote", "workflow", "jarvis-workflow"] },
              "configId": { "type": "integer" },
              "extensionName": { "type": "string" },
              "className": { "type": "string" },
              "sourceCode": { "type": "string" },
              "description": { "type": "string" },
              "extensionMode": { "type": "string" },
              "enabled": { "type": "integer", "enum": [0, 1] },
              "extensionParamValue": { "type": "string" },
              "bindingIds": { "type": "array", "items": { "type": "integer" } }
            },
            "required": ["action", "type", "configId"],
            "additionalProperties": false
          },
          {
            "properties": {
              "action": { "const": "delete" },
              "configId": { "type": "integer" }
