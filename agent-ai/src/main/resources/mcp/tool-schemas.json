{
  "$comment": "Interface Agent MCP Server — 8 个域级 Tool。McpToolRegistry 启动载入，tools/list 返回。tools/call 的 arguments 须与 inputSchema 平铺一致（仅含 action 及该 action 允许的字段），禁止用 extra 等额外顶层包装。成功时 content[0].text 为 JSON：{success,code,message,data}，data 结构见各 Tool 的 outputSchema。",
  "$defs": {
    "HealthCheckMcpView": {
      "type": "object",
      "properties": {
        "status": { "type": "string", "enum": ["UP", "DOWN"] },
        "serverName": { "type": "string" },
        "serverVersion": { "type": "string" },
        "database": { "type": "string", "enum": ["UP", "DOWN", "SKIPPED"] },
        "message": { "type": "string" }
      },
      "required": ["status", "serverName", "serverVersion", "database", "message"]
    },
    "Workflow": {
      "type": "object",
      "properties": {
        "flowId": { "type": "integer" },
        "flowName": { "type": "string" },
        "interfaceUri": { "type": "string" },
        "routeExtension": { "type": "string" },
        "contentType": { "type": "string", "enum": ["JSON", "XML"] },
        "contentMetaInfo": { "type": "string" },
        "firstFlowNodes": { "type": "array", "items": { "type": "integer" } },
        "status": { "type": "integer", "enum": [0, 1] }
      }
    },
    "WorkflowNodeMcpView": {
      "type": "object",
      "properties": {
        "nodeId": { "type": "integer" },
        "nodeName": { "type": "string" },
        "flowId": { "type": "integer" },
        "paramFilterExpr": { "type": "string" },
        "nodeType": { "type": "string", "enum": ["HTTP", "WEBSERVICE", "DATABASE", "NONE"] },
        "metaInfo": { "type": "string" },
        "splitField": { "type": "string" },
        "scheduleExpr": { "type": "string" },
        "scheduleParamSourceType": { "type": "string", "enum": ["ORIGINAL", "PRE_RESPONSE"] },
        "keywordField": { "type": "string" },
        "remoteExtension": { "type": "string" },
        "extensionParam": { "type": "string", "description": "JSON 字符串形式的扩展参数" }
      }
    },
    "WorkflowNode": {
      "type": "object",
      "description": "get 返回的领域对象；extensionParam 为 Map",
      "properties": {
        "nodeId": { "type": "integer" },
        "nodeName": { "type": "string" },
        "flowId": { "type": "integer" },
        "paramFilterExpr": { "type": "string" },
        "nodeType": { "type": "string", "enum": ["HTTP", "WEBSERVICE", "DATABASE", "NONE"] },
        "metaInfo": { "type": "string" },
        "splitField": { "type": "string" },
        "scheduleExpr": { "type": "string" },
        "scheduleParamSourceType": { "type": "string", "enum": ["ORIGINAL", "PRE_RESPONSE"] },
        "keywordField": { "type": "string" },
        "remoteExtension": { "type": "string" },
        "extensionParam": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "ParamConfig": {
      "type": "object",
      "description": "单条参数映射（childParams 嵌套树形）。import 时勿填 configId；update 时 config 须含 configId",
      "properties": {
        "configId": { "type": "integer", "description": "update/delete 使用；import 勿填" },
        "processType": { "type": "string", "enum": ["PRE_PROCESS", "POST_PROCESS"] },
        "sourceParamKey": { "type": "string" },
        "sourceParamType": {
          "type": "string",
          "enum": ["STRING", "INTEGER", "LONG", "BOOLEAN", "OBJECT", "ARRAY", "PURE_ARRAY", "NONE"]
        },
        "targetParamKey": { "type": "string" },
        "targetParamType": {
          "type": "string",
          "enum": ["STRING", "INTEGER", "LONG", "BOOLEAN", "OBJECT", "ARRAY", "PURE_ARRAY", "NONE"]
        },
        "paramDesc": { "type": "string" },
        "keepSingleElementKey": { "type": "boolean" },
        "sort": { "type": "integer" },
        "mappingType": {
          "type": "string",
          "enum": ["CONSTANT", "NAME", "EXPRESSION", "BEAN_EXPRESSION", "SINGLE_MAP"]
        },
        "mappingSource": { "type": "string", "enum": ["INPUT", "RESPONSE"] },
        "mappingRule": {
          "type": "string",
          "description": "NAME 可留空；EXPRESSION/CONSTANT/BEAN_EXPRESSION 填规则或固定值"
        },
        "childParams": {
          "type": "array",
          "items": { "$ref": "#/$defs/ParamConfig" }
        }
      }
    },
    "ParamConfigImport": {
      "allOf": [
        { "$ref": "#/$defs/ParamConfig" },
        {
          "required": ["processType", "sourceParamType", "targetParamKey", "targetParamType", "mappingType"]
        }
      ]
    },
    "NodeParamConfigMcpResponse": {
      "type": "object",
      "properties": {
        "nodeId": { "type": "integer" },
        "nodeName": { "type": "string" },
        "preProcessParams": {
          "type": "array",
          "items": { "$ref": "#/$defs/ParamConfig" }
        },
        "postProcessParams": {
          "type": "array",
          "items": { "$ref": "#/$defs/ParamConfig" }
        },
        "totalCount": { "type": "integer" }
      }
    },
    "MockConfigMcpView": {
      "type": "object",
      "properties": {
        "mockId": { "type": "integer" },
        "nodeId": { "type": "integer" },
        "caseName": { "type": "string" },
        "caseDesc": { "type": "string" },
        "mockResponse": { "type": "string" }
      }
    },
    "MockInvokeResult": {
      "type": "object",
      "properties": {
        "mockId": { "type": "integer" },
        "success": { "type": "boolean" },
        "message": { "type": "string" },
        "result": {
          "type": "object",
          "additionalProperties": true,
          "description": "单次 invoke 成功时的映射结果 Map"
        }
      },
      "required": ["mockId", "success", "message"]
    },
    "InvokeLogMcpView": {
      "type": "object",
      "properties": {
        "logId": { "type": "integer" },
        "nodeName": { "type": "string" },
        "keyword": { "type": "string" },
        "businessData": { "type": "string" },
        "paramBeforeInvoke": { "type": "string" },
        "remoteInvokeResponse": { "type": "string" },
        "remoteInvokeResponseParsed": { "type": "string" },
        "paramAfterInvoke": { "type": "string" },
        "invokeTime": { "type": "string" },
        "errorMessage": { "type": "string" },
        "createTime": { "type": "string", "format": "date-time" }
      }
    },
    "PageListInvokeLog": {
      "type": "object",
      "properties": {
        "total": { "type": "integer" },
        "pageNum": { "type": "integer" },
        "pageSize": { "type": "integer" },
        "rows": {
          "type": "array",
          "items": { "$ref": "#/$defs/InvokeLogMcpView" }
        }
      },
      "required": ["total", "pageNum", "pageSize", "rows"]
    },
    "ExtensionMcpView": {
      "type": "object",
      "properties": {
        "configId": { "type": "integer" },
        "bindingIds": { "type": "array", "items": { "type": "integer" } },
        "spiInterface": { "type": "string" },
        "extensionName": { "type": "string" },
        "className": { "type": "string" },
        "sourceCode": { "type": "string" },
        "description": { "type": "string" },
        "extensionMode": { "type": "string" },
        "enabled": { "type": "integer", "enum": [0, 1] },
        "extensionParamValue": { "type": "string" }
      }
    },
    "SuccessMessage": {
      "type": "string",
      "description": "操作成功提示文案"
    }
  },
  "tools": [
    {
      "name": "agent_health",
      "description": "Interface Agent 健康检查。自动化配置前应先 action=check；ping 仅探测 MCP 进程。",
      "inputSchema": {
        "type": "object",
        "required": ["action"],
        "additionalProperties": false,
        "properties": {
          "action": { "type": "string", "enum": ["ping", "check"] }
        }
      },
      "outputSchema": {
        "description": "McpToolPayload.data = HealthCheckMcpView",
        "$ref": "#/$defs/HealthCheckMcpView"
      }
    },
    {
      "name": "agent_workflow",
      "description": "管理工作流（对外接口/路由）。create 返回 flowId；update 返回受影响行数。",
      "inputSchema": {
        "type": "object",
        "required": ["action"],
        "properties": {
          "action": {
            "type": "string",
            "enum": ["list", "get", "create", "update", "delete"]
          }
        },
        "oneOf": [
          {
            "properties": { "action": { "const": "list" } },
            "required": ["action"],
            "additionalProperties": false
          },
          {
            "properties": {
              "action": { "const": "get" },
              "flowId": { "type": "integer" }
            },
            "required": ["action", "flowId"],
            "additionalProperties": false
          },
          {
            "properties": {
              "action": { "const": "create" },
              "flowName": { "type": "string" },
              "interfaceUri": { "type": "string" },
              "routeExtension": { "type": "string" },
              "contentType": { "type": "string", "enum": ["JSON", "XML"] },
              "contentMetaInfo": { "type": "string" },
              "firstFlowNodes": { "type": "array", "items": { "type": "integer" } },
              "status": { "type": "integer", "enum": [0, 1] }
            },
            "required": ["action", "flowName", "interfaceUri"],
            "additionalProperties": false
          },
          {
            "properties": {
              "action": { "const": "update" },
              "flowId": { "type": "integer" },
              "flowName": { "type": "string" },
              "interfaceUri": { "type": "string" },
              "routeExtension": { "type": "string" },
              "contentType": { "type": "string", "enum": ["JSON", "XML"] },
              "contentMetaInfo": { "type": "string" },
              "firstFlowNodes": { "type": "array", "items": { "type": "integer" } },
              "status": { "type": "integer", "enum": [0, 1] }
            },
            "required": ["action", "flowId"],
            "additionalProperties": false
          },
          {
            "properties": {
              "action": { "const": "delete" },
              "flowId": { "type": "integer" }
            },
            "required": ["action", "flowId"],
            "additionalProperties": false
          }
        ]
      },
      "outputSchema": {
        "description": "McpToolPayload.data 按 action 区分",
        "oneOf": [
          {
            "title": "list",
            "type": "array",
            "items": { "$ref": "#/$defs/Workflow" }
          },
          {
            "title": "get",
            "$ref": "#/$defs/Workflow"
          },
          {
            "title": "create",
            "type": "integer",
            "description": "新建 flowId"
          },
          {
            "title": "update",
            "type": "integer",
            "description": "受影响行数"
          },
          {
            "title": "delete",
            "$ref": "#/$defs/SuccessMessage"
          }
        ]
      }
    },
    {
      "name": "agent_workflow_node",
      "description": "管理工作流节点（HTTP/WEBSERVICE/DATABASE/NONE）。create 返回 nodeId；list 返回 McpView；get 返回领域对象。",
      "inputSchema": {
        "type": "object",
        "required": ["action"],
        "properties": {
          "action": {
            "type": "string",
            "enum": ["list", "get", "create", "update", "delete"]
          }
        },
        "oneOf": [
          {
            "properties": { "action": { "const": "list" } },
            "required": ["action"],
            "additionalProperties": false
          },
          {
            "properties": {
              "action": { "const": "get" },
              "nodeId": { "type": "integer" }
            },
            "required": ["action", "nodeId"],
            "additionalProperties": false
          },
          {
            "properties": {
              "action": { "const": "create" },
              "nodeName": { "type": "string" },
              "flowId": { "type": "integer" },
              "nodeType": { "type": "string", "enum": ["HTTP", "WEBSERVICE", "DATABASE", "NONE"] },
              "metaInfo": { "type": "string" },
              "paramFilterExpr": { "type": "string" },
              "splitField": { "type": "string" },
              "keywordField": { "type": "string" },
              "scheduleExpr": { "type": "string" },
              "scheduleParamSourceType": { "type": "string", "enum": ["ORIGINAL", "PRE_RESPONSE"] },
              "remoteExtension": { "type": "string" },
              "extensionParam": { "type": "string", "description": "JSON 字符串，如 {\"key\":\"value\"}" }
            },
            "required": ["action", "nodeName", "nodeType"],
            "additionalProperties": false
          },
          {
            "properties": {
              "action": { "const": "update" },
              "nodeId": { "type": "integer" },
              "nodeName": { "type": "string" },
              "flowId": { "type": "integer" },
              "nodeType": { "type": "string", "enum": ["HTTP", "WEBSERVICE", "DATABASE", "NONE"] },
              "metaInfo": { "type": "string" },
              "paramFilterExpr": { "type": "string" },
              "splitField": { "type": "string" },
              "keywordField": { "type": "string" },
              "scheduleExpr": { "type": "string" },
              "scheduleParamSourceType": { "type": "string", "enum": ["ORIGINAL", "PRE_RESPONSE"] },
              "remoteExtension": { "type": "string" },
              "extensionParam": { "type": "string" }
            },
            "required": ["action", "nodeId"],
            "additionalProperties": false
          },
          {
            "properties": {
              "action": { "const": "delete" },
              "nodeId": { "type": "integer" }
            },
            "required": ["action", "nodeId"],
            "additionalProperties": false
          }
        ]
      },
      "outputSchema": {
        "oneOf": [
          {
            "title": "list",
            "type": "array",
            "items": { "$ref": "#/$defs/WorkflowNodeMcpView" }
          },
          {
            "title": "get",
            "$ref": "#/$defs/WorkflowNode"
          },
          {
            "title": "create",
            "type": "integer",
            "description": "新建 nodeId"
          },
          {
            "title": "update",
            "type": "integer",
            "description": "受影响行数"
          },
          {
            "title": "delete",
            "$ref": "#/$defs/SuccessMessage"
          }
        ]
      }
    },
    {
      "name": "agent_node_param_config",
      "description": "节点参数映射 PRE_PROCESS/POST_PROCESS。import 顶层仅 action/nodeId/clearBeforeImport/params（平铺，禁止 extra）。import 后建议 agent_mock_invoke.invoke 自检。",
      "inputSchema": {
        "type": "object",
        "required": ["action"],
        "properties": {
          "action": {
            "type": "string",
            "enum": ["list", "export", "import", "update", "delete", "delete_all"]
          }
        },
        "oneOf": [
          {
            "properties": {
              "action": { "const": "list" },
              "nodeId": { "type": "integer" },
              "processType": { "type": "string", "enum": ["PRE_PROCESS", "POST_PROCESS"] }
            },
            "required": ["action", "nodeId"],
            "additionalProperties": false
          },
          {
            "properties": {
              "action": { "const": "export" },
              "nodeId": { "type": "integer" }
            },
            "required": ["action", "nodeId"],
            "additionalProperties": false
          },
          {
            "properties": {
              "action": { "const": "import" },
              "nodeId": { "type": "integer" },
              "clearBeforeImport": { "type": "boolean", "default": true },
              "params": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/ParamConfigImport" }
              }
            },
            "required": ["action", "nodeId", "params"],
            "additionalProperties": false
          },
          {
            "properties": {
              "action": { "const": "update" },
              "config": {
                "allOf": [
                  { "$ref": "#/$defs/ParamConfig" },
                  { "required": ["configId"] }
                ]
              }
            },
            "required": ["action", "config"],
            "additionalProperties": false
          },
          {
            "properties": {
              "action": { "const": "delete" },
              "configId": { "type": "integer" }
            },
            "required": ["action", "configId"],
            "additionalProperties": false
          },
          {
            "properties": {
              "action": { "const": "delete_all" },
              "nodeId": { "type": "integer" }
            },
            "required": ["action", "nodeId"],
            "additionalProperties": false
          }
        ]
      },
      "outputSchema": {
        "oneOf": [
          {
            "title": "list",
            "type": "array",
            "description": "扁平列表（非树形）",
            "items": { "$ref": "#/$defs/ParamConfig" }
          },
          {
            "title": "export",
            "$ref": "#/$defs/NodeParamConfigMcpResponse"
          },
          {
            "title": "import",
            "$ref": "#/$defs/SuccessMessage"
          },
          {
            "title": "update",
            "$ref": "#/$defs/ParamConfig"
          },
          {
            "title": "delete",
            "$ref": "#/$defs/SuccessMessage"
          },
          {
            "title": "delete_all",
            "$ref": "#/$defs/SuccessMessage"
          }
        ]
      }
    },
    {
      "name": "agent_mock_config",
      "description": "节点 Mock 配置。create 返回 mockId；delete_by_node 按节点批量删除。",
      "inputSchema": {
        "type": "object",
        "required": ["action"],
        "properties": {
          "action": {
            "type": "string",
            "enum": ["list", "get", "create", "update", "delete", "delete_by_node"]
          }
        },
        "oneOf": [
          {
            "properties": {
              "action": { "const": "list" },
              "nodeId": { "type": "integer" }
            },
            "required": ["action", "nodeId"],
            "additionalProperties": false
          },
          {
            "properties": {
              "action": { "const": "get" },
              "mockId": { "type": "integer" }
            },
            "required": ["action", "mockId"],
            "additionalProperties": false
          },
          {
            "properties": {
              "action": { "const": "create" },
              "nodeId": { "type": "integer" },
              "caseName": { "type": "string" },
              "caseDesc": { "type": "string" },
              "mockResponse": { "type": "string" }
            },
            "required": ["action", "nodeId", "caseName", "mockResponse"],
            "additionalProperties": false
          },
          {
            "properties": {
              "action": { "const": "update" },
              "mockId": { "type": "integer" },
              "caseName": { "type": "string" },
              "caseDesc": { "type": "string" },
              "mockResponse": { "type": "string" }
            },
            "required": ["action", "mockId"],
            "additionalProperties": false
          },
          {
            "properties": {
              "action": { "const": "delete" },
              "mockId": { "type": "integer" }
            },
            "required": ["action", "mockId"],
            "additionalProperties": false
          },
          {
            "properties": {
              "action": { "const": "delete_by_node" },
              "nodeId": { "type": "integer" }
            },
            "required": ["action", "nodeId"],
            "additionalProperties": false
          }
        ]
      },
      "outputSchema": {
        "oneOf": [
          {
            "title": "list",
            "type": "array",
            "items": { "$ref": "#/$defs/MockConfigMcpView" }
          },
          {
            "title": "get",
            "$ref": "#/$defs/MockConfigMcpView"
          },
          {
            "title": "create",
            "type": "integer",
            "description": "新建 mockId"
          },
          {
            "title": "update",
            "type": "integer",
            "description": "受影响行数"
          },
          {
            "title": "delete",
            "$ref": "#/$defs/SuccessMessage"
          },
          {
            "title": "delete_by_node",
            "$ref": "#/$defs/SuccessMessage"
          }
        ]
      }
    },
    {
      "name": "agent_mock_invoke",
      "description": "Mock 链路验证。invoke 返回映射结果 Map；batch_invoke 返回各 mockId 成败列表。businessData 可省略（视为空对象）。",
      "inputSchema": {
        "type": "object",
        "required": ["action"],
        "properties": {
          "action": { "type": "string", "enum": ["invoke", "batch_invoke"] }
        },
        "oneOf": [
          {
            "properties": {
              "action": { "const": "invoke" },
              "nodeId": { "type": "integer" },
              "mockId": { "type": "integer" },
              "businessData": {
                "type": "object",
                "additionalProperties": true,
                "description": "业务入参，可省略"
              }
            },
            "required": ["action", "nodeId", "mockId"],
            "additionalProperties": false
          },
          {
            "properties": {
              "action": { "const": "batch_invoke" },
              "nodeId": { "type": "integer" },
              "mockIds": {
                "type": "array",
                "items": { "type": "integer" },
                "minItems": 1
              },
              "businessData": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "required": ["action", "nodeId", "mockIds"],
            "additionalProperties": false
          }
        ]
      },
      "outputSchema": {
        "oneOf": [
          {
            "title": "invoke",
            "type": "object",
            "additionalProperties": true,
            "description": "后置映射后的结果 Map"
          },
          {
            "title": "batch_invoke",
            "type": "array",
            "items": { "$ref": "#/$defs/MockInvokeResult" }
          }
        ]
      }
    },
    {
      "name": "agent_invoke_log",
      "description": "调用日志查询。list/latest/by_keyword/by_node 均返回分页 PageList。",
      "inputSchema": {
        "type": "object",
        "required": ["action"],
        "properties": {
          "action": { "type": "string", "enum": ["list", "latest", "by_keyword", "by_node"] }
        },
        "oneOf": [
          {
            "properties": {
              "action": { "const": "list" },
              "nodeName": { "type": "string" },
              "keyword": { "type": "string" },
              "pageNum": { "type": "integer", "default": 1, "minimum": 1 },
              "pageSize": { "type": "integer", "default": 10, "minimum": 1, "maximum": 100 }
            },
            "required": ["action"],
            "additionalProperties": false
          },
          {
            "properties": {
              "action": { "const": "latest" },
              "limit": { "type": "integer", "default": 5, "minimum": 1, "maximum": 50 }
            },
            "required": ["action"],
            "additionalProperties": false
          },
          {
            "properties": {
              "action": { "const": "by_keyword" },
              "keyword": { "type": "string" },
              "limit": { "type": "integer", "default": 10, "minimum": 1, "maximum": 100 }
            },
            "required": ["action", "keyword"],
            "additionalProperties": false
          },
          {
            "properties": {
              "action": { "const": "by_node" },
              "nodeName": { "type": "string" },
              "pageNum": { "type": "integer", "default": 1, "minimum": 1 },
              "pageSize": { "type": "integer", "default": 10, "minimum": 1, "maximum": 100 }
            },
            "required": ["action", "nodeName"],
            "additionalProperties": false
          }
        ]
      },
      "outputSchema": {
        "description": "各 action 均返回 PageList<InvokeLogMcpView>",
        "$ref": "#/$defs/PageListInvokeLog"
      }
    },
    {
      "name": "agent_spi_extension",
