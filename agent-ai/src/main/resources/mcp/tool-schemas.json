          },
          {
            "title": "update",
            "$ref": "#/$defs/SuccessMessage"
          },
          {
            "title": "delete",
            "$ref": "#/$defs/SuccessMessage"
          },
          {
            "title": "enable",
            "$ref": "#/$defs/SuccessMessage"
          },
          {
            "title": "disable",
            "$ref": "#/$defs/SuccessMessage"
          }
        ]
      }
    }
