              "className": { "type": "string" },
              "sourceCode": { "type": "string" },
              "description": { "type": "string" },
              "extensionMode": { "type": "string" },
              "enabled": { "type": "integer", "enum": [0, 1] },
              "extensionParamValue": { "type": "string" },
