            "required": ["action", "configId"],
            "additionalProperties": false
          },
          {
            "properties": {
              "action": { "const": "disable" },
              "configId": { "type": "integer" }
            },
            "required": ["action", "configId"],
            "additionalProperties": false
          }
        ]
      },
      "outputSchema": {
        "oneOf": [
