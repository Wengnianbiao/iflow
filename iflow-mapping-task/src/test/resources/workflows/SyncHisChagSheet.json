{
  "route": "SyncHisChagSheet",
  "name": "发送账单",
  "version": 1,
  "description": "Jarvis SyncHisChagSheet：用 chagPatientSheet.idPatientSheet 作为 orderId 调用 EXCHANGE-CHARGE-001 orderConfirmFee，directId=1 发送账单。正式网关 http://132.147.181.4/gateway/api，测试网关 http://132.147.181.104/gateway/api。回写 code / message / rsp.presId。",
  "timeoutPolicy": "TIME_OUT_WF",
  "correlationExpression": "${workflow.input.data.patientInfo.patientCode}",
  "inputParameters": [
    "data",
    "BusinessMethod",
    "BusinessCode",
    "DepartType"
  ],
  "outputParameters": {
    "code": "${map_output_ref.output.code}",
    "message": "${map_output_ref.output.message}",
    "rsp": "${map_output_ref.output.rsp}"
  },
  "tasks": [
    {
      "name": "映射医嘱计费报文",
      "taskReferenceName": "map_his_fee_ref",
      "type": "MAPPING",
      "optional": false,
      "inputParameters": {
        "payload": "${workflow.input.data}",
        "paramsConfig": [
          {
            "targetParamKey": "order",
            "targetParamType": "OBJECT",
            "mappingType": "OBJECT",
            "paramDesc": "orderConfirmFee 单条医嘱",
            "childParams": [
              {
                "sourceParamKey": "$.chagPatientSheet.idPatientSheet",
                "targetParamKey": "orderId",
                "targetParamType": "STRING",
                "mappingType": "NAME",
                "paramDesc": "医嘱编码，取账单 idPatientSheet"
              },
              {
                "sourceParamKey": "$.patientInfo.visitNo",
                "targetParamKey": "visitNumber",
                "targetParamType": "STRING",
                "mappingType": "NAME",
                "paramDesc": "就诊流水号"
              },
              {
                "targetParamKey": "departmentId",
                "targetParamType": "STRING",
                "mappingType": "CONSTANT",
                "mappingRule": "66fca4551d3a1d0001fab02d",
                "paramDesc": "操作科室Id"
              },
              {
                "targetParamKey": "confirmTime",
                "targetParamType": "STRING",
                "mappingType": "EXPRESSION",
                "mappingRule": "(function () {\n  function pad(n) { return n < 10 ? '0' + n : String(n); }\n  var d = new Date();\n  return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) + ' ' + pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds());\n})()",
                "paramDesc": "确认时间"
              },
              {
                "targetParamKey": "userId",
                "targetParamType": "STRING",
                "mappingType": "CONSTANT",
                "mappingRule": "6a4db0dc4da7fc0001a9609a",
                "paramDesc": "操作人Id"
              },
              {
                "targetParamKey": "directId",
                "targetParamType": "STRING",
                "mappingType": "CONSTANT",
                "mappingRule": "1",
                "paramDesc": "确认收费：计费"
              },
              {
                "targetParamKey": "visitTypeCode",
                "targetParamType": "STRING",
                "mappingType": "CONSTANT",
                "mappingRule": "114",
                "paramDesc": "就诊类型"
              },
              {
                "targetParamKey": "organizationId",
                "targetParamType": "STRING",
                "mappingType": "CONSTANT",
                "mappingRule": "66fca42db0c0ad0001f1a9f4",
                "paramDesc": "机构ID"
              },
              {
                "targetParamKey": "applicationDepartmentId",
                "targetParamType": "STRING",
                "mappingType": "CONSTANT",
                "mappingRule": "0921",
                "paramDesc": "确认科室编码"
              },
              {
                "targetParamKey": "accountId",
                "targetParamType": "STRING",
                "mappingType": "CONSTANT",
                "mappingRule": "66fca570063ef80001a5da41",
                "paramDesc": "基础数据账户"
              },
              {
                "targetParamKey": "mainInsurancePlanId",
                "targetParamType": "STRING",
                "mappingType": "CONSTANT",
                "mappingRule": null,
                "paramDesc": "执行计划编码"
              },
              {
                "targetParamKey": "sender",
                "targetParamType": "STRING",
                "mappingType": "CONSTANT",
                "mappingRule": "HELIAN-TJ",
                "paramDesc": "发送方"
              },
              {
                "targetParamKey": "applicationEmployeeId",
                "targetParamType": "STRING",
                "mappingType": "CONSTANT",
                "mappingRule": "XT_HLJK_TJ",
                "paramDesc": "确认人员编码"
              },
              {
                "targetParamKey": "tenantId",
                "targetParamType": "STRING",
                "mappingType": "CONSTANT",
                "mappingRule": "GHIS",
                "paramDesc": "租户ID"
              }
            ]
          },
          {
            "sourceParamKey": "$.chagPatientSheet.idPatientSheet",
            "targetParamKey": "presId",
            "targetParamType": "STRING",
            "mappingType": "NAME",
            "paramDesc": "回写账单号，等于 idPatientSheet"
          },
          {
            "targetParamKey": "timestamp",
            "targetParamType": "STRING",
            "mappingType": "EXPRESSION",
            "mappingRule": "String(Date.now())",
            "paramDesc": "当前时间戳"
          }
        ]
      }
    },
    {
      "name": "序列化医嘱计费报文",
      "taskReferenceName": "serialize_fee_ref",
      "type": "INLINE",
      "optional": false,
      "inputParameters": {
        "order": "${map_his_fee_ref.output.order}",
        "evaluatorType": "graaljs",
        "expression": "JSON.stringify([$.order])"
      }
    },
    {
      "name": "调用HIS医嘱计费",
      "taskReferenceName": "call_his_ref",
      "type": "HTTP",
      "optional": false,
      "inputParameters": {
        "uri": "http://132.147.181.4/gateway/api",
        "method": "POST",
        "contentType": "application/json",
        "accept": "application/json",
        "connectionTimeOut": 5000,
        "readTimeOut": 30000,
        "body": {
          "appId": "6a4daeb8b4ac040015386004",
          "encryptData": "${serialize_fee_ref.output}",
          "sign": "",
          "timestamp": "${map_his_fee_ref.output.timestamp}",
          "version": "1.0.0",
          "beanName": "exchange.stand.orderConfirmFeeProvider",
          "methodName": "orderConfirmFee"
        }
      }
    },
    {
      "name": "反序列化HIS响应",
      "taskReferenceName": "parse_encrypt_ref",
      "type": "INLINE",
      "optional": false,
      "inputParameters": {
        "encryptData": "${call_his_ref.output.body.encryptData}",
        "evaluatorType": "graaljs",
        "expression": "(function () {\n  var raw = $.encryptData;\n  if (raw == null || raw === '') return {};\n  if (typeof raw === 'string') return JSON.parse(raw);\n  return raw;\n})()"
      }
    },
    {
      "name": "映射发送账单出参",
      "taskReferenceName": "map_output_ref",
      "type": "MAPPING",
      "optional": false,
      "inputParameters": {
        "payload": {
          "biz": "${parse_encrypt_ref.output}",
          "presId": "${map_his_fee_ref.output.presId}"
        },
        "paramsConfig": [
          {
            "targetParamKey": "code",
            "targetParamType": "STRING",
            "mappingType": "EXPRESSION",
            "mappingRule": "(['200', '0'].includes(String($.biz?.code)) && ($.biz?.status == null || $.biz.status === true)) ? '200' : '-1'",
            "paramDesc": "200成功 / -1失败，只看反序列化后的业务码和 status"
          },
          {
            "targetParamKey": "message",
            "targetParamType": "STRING",
            "mappingType": "EXPRESSION",
            "mappingRule": "(['200', '0'].includes(String($.biz?.code)) && ($.biz?.status == null || $.biz.status === true)) ? '成功' : ($.biz?.detail || '失败')",
            "paramDesc": "成功文案或 HIS detail"
          },
          {
            "targetParamKey": "rsp",
            "targetParamType": "OBJECT",
            "mappingType": "OBJECT",
            "paramDesc": "账单回写",
            "childParams": [
              {
                "sourceParamKey": "$.presId",
                "targetParamKey": "presId",
                "targetParamType": "STRING",
                "mappingType": "NAME",
                "paramDesc": "账单号 idPatientSheet"
              }
            ]
          }
        ]
      }
    }
  ]
}
