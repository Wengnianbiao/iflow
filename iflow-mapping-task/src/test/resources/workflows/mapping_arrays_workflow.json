{
  "name": "mapping_arrays_example",
  "displayName": "数组映射示例",
  "version": 1,
  "schemaVersion": 2,
  "description": "输入 patientId、items，演示循环生成与固定单元素数组。",
  "inputParameters": [
    "patientId",
    "items"
  ],
  "tasks": [
    {
      "name": "组装三方请求",
      "taskReferenceName": "mapping_request_ref",
      "type": "MAPPING",
      "inputParameters": {
        "payload": "${workflow.input}",
        "paramsConfig": [
          {
            "targetParamKey": "hospitalCode",
            "targetParamType": "STRING",
            "mappingType": "CONSTANT",
            "mappingRule": "H001"
          },
          {
            "targetParamKey": "details",
            "targetParamType": "ARRAY",
            "mappingType": "ARRAY_MAP",
            "sourceParamKey": "$.items",
            "itemAlias": "item",
            "itemTemplate": {
              "targetParamType": "OBJECT",
              "mappingType": "OBJECT",
              "childParams": [
                {
                  "targetParamKey": "itemCode",
                  "targetParamType": "STRING",
                  "mappingType": "NAME",
                  "sourceParamKey": "item.code"
                },
                {
                  "targetParamKey": "quantity",
                  "targetParamType": "INTEGER",
                  "mappingType": "NAME",
                  "sourceParamKey": "item.qty"
                },
                {
                  "targetParamKey": "patientId",
                  "targetParamType": "STRING",
                  "mappingType": "NAME",
                  "sourceParamKey": "$.patientId"
                },
                {
                  "targetParamKey": "enabled",
                  "targetParamType": "BOOLEAN",
                  "mappingType": "CONSTANT",
                  "mappingRule": true
                }
              ]
            }
          },
          {
            "targetParamKey": "patients",
            "targetParamType": "ARRAY",
            "mappingType": "ARRAY_FIXED",
            "items": [
              {
                "targetParamType": "OBJECT",
                "mappingType": "OBJECT",
                "childParams": [
                  {
                    "targetParamKey": "id",
                    "targetParamType": "STRING",
                    "mappingType": "NAME",
                    "sourceParamKey": "$.patientId"
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  ]
}
